# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# Claude API 키 (없으면 규칙 기반 예비 판단으로 동작)
ANTHROPIC_API_KEY=

# 사용할 모델과 판단 깊이 (기본값: claude-opus-5-5, high)
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=high

# 로컬 DB (비우면 backend/local.db SQLite 사용). AXHub 에서는 자동으로 들어옵니다.
# DATABASE_URL=

# 개발 중 화면(Next.js 개발 서버) 주소 허용
CORS_ORIGINS=http://localhost:3000
